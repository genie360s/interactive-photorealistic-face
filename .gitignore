# dependencies and build output
node_modules/
dist/

# offline pipeline environment + the MediaPipe model it downloads (~30 MB)
tools/.venv/
tools/face_landmarker.task

# intermediate measurements: regenerated by the pipeline, large and binary.
# The .json measurements are kept — they are the actual data the model is
# built from and they are small.
assets/facedata/*.npz
assets/facedata/*_atlas.png

# verification output is regenerated by `node tools/verify_model.mjs`;
# the report itself is small enough to be worth keeping as evidence
verification/*
!verification/
!verification/model-report.json

.playwright-mcp/
*.log
.DS_Store

# python bytecode
__pycache__/
*.pyc
